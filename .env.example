# === Filtry krajów ===
# Filtr pozytywny - jeśli ustawiony, tylko te kraje (oddzielone przecinkami)
COUNTRIES_INCLUDE=

# Filtr negatywny - te kraje pomijane (oddzielone przecinkami)
COUNTRIES_EXCLUDE=Niemcy,Francja,Holandia,Belgia,Irlandia,UK

# === Scraper ===
PAGES=3
BASE_URL=https://www.pracuj.pl/praca/zagranica;r,17?sc=0

# Katalog z przeglądarkami Playwrighta. Puste = katalog .playwright w projekcie.
# NIE ustawiaj na wspólny ~/.cache/ms-playwright, jeśli na koncie są inne projekty
# z Playwrightem - ich `playwright install` potrafi skasować stamtąd binarkę Chromium.
PLAYWRIGHT_BROWSERS_PATH=

# === SMTP ===
SMTP_SERVER=mail.example.com
SMTP_PORT=587
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=haslo
EMAIL_FROM=user@example.com
EMAIL_TO=odbiorca@example.com

# Wysyłka maili z ofertami: 0 = wyłączona (tylko panel webowy)
SEND_EMAIL=1

# === Alarmy o awarii (watchdog) ===
# Działają niezależnie od SEND_EMAIL. Domyślnie używają ustawień SMTP powyżej,
# można je nadpisać przez ALERT_SMTP_SERVER / ALERT_SMTP_PORT /
# ALERT_SMTP_USERNAME / ALERT_SMTP_PASSWORD / ALERT_EMAIL_FROM.
SEND_ALERTS=1
ALERT_EMAIL_TO=monitor@web-systems.pl

# Minimalny odstęp między kolejnymi alarmami o tej samej awarii (godziny)
ALERT_COOLDOWN_HOURS=12
# Minimalny odstęp między automatycznymi próbami naprawy (godziny)
REPAIR_COOLDOWN_HOURS=6

# === Panel webowy ===
APP_SECRET=zmien-na-losowy-ciag
APP_USER=coolkarz
APP_PASS=Praca1
APP_PORT=5000

# Po ilu godzinach bez świeżych danych panel pokazuje ostrzeżenie
STALE_AFTER_HOURS=30
